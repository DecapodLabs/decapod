# Decapod workspace image shim, kept with repository assets.
#
# This image publishes a released Decapod binary for generated project workspace
# containers. Consumer projects still maintain their own
# .decapod/managed/Dockerfile.decapod sandbox layers for Docker or Podman workspaces.

ARG DECAPOD_BUILD_IMAGE=rust:1.96.1-slim-bookworm
ARG DECAPOD_RUNTIME_IMAGE=debian:bookworm-slim

FROM ${DECAPOD_BUILD_IMAGE} AS build

WORKDIR /src
RUN if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache build-base ca-certificates sqlite-dev sqlite-static; \
    elif command -v apt-get >/dev/null 2>&1; then \
        apt-get update && \
        apt-get install -y --no-install-recommends build-essential ca-certificates libsqlite3-dev pkg-config && \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "No supported package manager found" >&2; exit 1; \
    fi
COPY . .
RUN cargo install --path . --locked --root /opt/decapod

FROM ${DECAPOD_RUNTIME_IMAGE}

ARG DECAPOD_VERSION=unknown
ARG DECAPOD_REVISION=unknown
LABEL org.opencontainers.image.title="decapod"
LABEL org.opencontainers.image.description="Decapod release image for generated workspace containers"
LABEL org.opencontainers.image.version="$DECAPOD_VERSION"
LABEL org.opencontainers.image.revision="$DECAPOD_REVISION"
LABEL org.opencontainers.image.source="https://github.com/DecapodLabs/decapod"

RUN if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache bash ca-certificates coreutils curl git openssh-client sqlite-libs; \
    elif command -v apt-get >/dev/null 2>&1; then \
        apt-get update && \
        apt-get install -y --no-install-recommends bash ca-certificates coreutils curl git openssh-client libsqlite3-0 && \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "No supported package manager found" >&2; exit 1; \
    fi
RUN update-ca-certificates
COPY --from=build /opt/decapod/bin/decapod /usr/local/bin/decapod
RUN /usr/local/bin/decapod --help >/dev/null
