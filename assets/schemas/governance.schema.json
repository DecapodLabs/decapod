{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decapod.dev/schemas/governance-1.0.0.schema.json",
  "title": "PR-scoped canonical governance document",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted_commit": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "object"
        },
        "unresolved": {
          "type": "object"
        }
      },
      "required": []
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "minLength": 1
        },
        "target_base": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "base_commit",
        "target_base"
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "falsifier": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "supported",
              "refuted",
              "blocked"
            ]
          },
          "proof_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "statement",
          "falsifier",
          "status"
        ]
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "input_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "proof_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "summary",
          "input_digest"
        ]
      }
    },
    "intents": {
      "type": "object"
    },
    "epochs": {
      "type": "object"
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "type": "object"
        },
        "trajectory": {
          "type": "object"
        },
        "validation": {
          "type": "object"
        },
        "jev": {
          "type": "object"
        }
      },
      "required": []
    },
    "recursive_passes": {
      "type": "object"
    },
    "legacy_claims": {
      "type": "object",
      "description": "Lossless transition input; explicit begin-pr archives committed historical claims"
    },
    "legacy_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "resolutions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_digest",
          "resolution",
          "proof_refs"
        ],
        "properties": {
          "obligation_digest": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "proof_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "baseline"
  ]
}
