{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decapod.dev/schemas/interop-json-vectors-1.0.0.schema.json",
  "title": "Portable JSON interpretation vectors 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "profile_version",
    "scope",
    "vectors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "decapod.interop.encoding"
    },
    "profile_version": {
      "const": "1.0.0"
    },
    "scope": {
      "const": "raw_json_decoding_only"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "raw",
        "expected",
        "family",
        "positive_twin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "raw": {
          "type": "string"
        },
        "expected": {
          "enum": [
            "accepted",
            "invalid_json"
          ]
        },
        "family": {
          "enum": [
            "syntax",
            "duplicate_key",
            "unicode",
            "number",
            "depth"
          ]
        },
        "positive_twin": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
