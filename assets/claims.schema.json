{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decapod.dev/schemas/research-claims-ledger-1.0.0.schema.json",
  "title": "Decapod Research Claims Ledger",
  "description": "Closed, evidence-bounded contract for falsifiable research claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "ledger_id",
    "title",
    "purpose",
    "authority",
    "scope",
    "methodology",
    "claims",
    "governance"
  ],
  "properties": {
    "$schema": {
      "const": "https://decapod.dev/schemas/research-claims-ledger-1.0.0.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "research_claims_ledger"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "$ref": "#/$defs/Authority"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "methodology": {
      "$ref": "#/$defs/Methodology"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Claim"
      }
    },
    "governance": {
      "$ref": "#/$defs/Governance"
    }
  },
  "$defs": {
    "Authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "source_issue",
        "status",
        "created_at",
        "updated_at",
        "change_policy"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "source_issue": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ]
        },
        "created_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "updated_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "change_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "repository",
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "falsifiability_standard",
        "evidence_statuses",
        "measurement_rules"
      ],
      "properties": {
        "falsifiability_standard": {
          "type": "string",
          "minLength": 1
        },
        "evidence_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "not_started",
              "instrumented",
              "partial",
              "supported",
              "falsified",
              "superseded"
            ]
          }
        },
        "measurement_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/MeasurementRule"
          }
        }
      }
    },
    "MeasurementRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "requirement",
        "unit",
        "evidence_source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "evidence_source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "title",
        "statement",
        "why_it_matters",
        "baseline",
        "decapod_condition",
        "failure_modes",
        "measurements",
        "proof_gate",
        "open_questions",
        "evidence",
        "implementation_links",
        "non_guarantees"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "$ref": "#/$defs/ExperimentCondition"
        },
        "decapod_condition": {
          "$ref": "#/$defs/ExperimentCondition"
        },
        "failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/FailureMode"
          }
        },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Measurement"
          }
        },
        "proof_gate": {
          "$ref": "#/$defs/ProofGate"
        },
        "open_questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/OpenQuestion"
          }
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "implementation_links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ImplementationLink"
          }
        },
        "non_guarantees": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ExperimentCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "population",
        "unit_of_analysis",
        "protocol",
        "controls",
        "confounders"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "unit_of_analysis": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confounders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "FailureMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "observable_signal",
        "severity",
        "falsifier"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "observable_signal": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "falsifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "definition",
        "unit",
        "scale",
        "aggregation",
        "collection_method",
        "comparator",
        "success_direction",
        "threshold"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "count",
            "ratio",
            "seconds",
            "tokens",
            "boolean",
            "categorical"
          ]
        },
        "scale": {
          "enum": [
            "ratio",
            "interval",
            "ordinal",
            "nominal"
          ]
        },
        "aggregation": {
          "enum": [
            "mean",
            "median",
            "rate",
            "count",
            "distribution",
            "qualitative"
          ]
        },
        "collection_method": {
          "type": "string",
          "minLength": 1
        },
        "comparator": {
          "type": "string",
          "minLength": 1
        },
        "success_direction": {
          "enum": [
            "lower",
            "higher",
            "match",
            "absence"
          ]
        },
        "threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/Threshold"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "value",
        "unit"
      ],
      "properties": {
        "operator": {
          "enum": [
            "lt",
            "lte",
            "eq",
            "gte",
            "gt",
            "neq"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ProofGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required_artifacts",
        "required_commands",
        "acceptance_criteria",
        "failure_behavior"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "required_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ArtifactRequirement"
          }
        },
        "required_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CommandRequirement"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ArtifactRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "required",
        "integrity",
        "relationship"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "trajectory",
            "receipt",
            "capsule",
            "todo",
            "test",
            "document",
            "schema"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "integrity": {
          "enum": [
            "hash",
            "schema",
            "git-tracked",
            "manual-review"
          ]
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CommandRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "expected_exit_code",
        "bounded_seconds",
        "evidence_artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "expected_exit_code": {
          "type": "integer"
        },
        "bounded_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "OpenQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "decision_impact",
        "owner",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "decision_impact": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "deferred"
          ]
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "sources",
        "observations",
        "last_evaluated_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "instrumented",
            "partial",
            "supported",
            "falsified",
            "superseded"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/EvidenceSource"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "last_evaluated_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "EvidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ref",
        "description",
        "trust"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "issue",
            "code",
            "test",
            "artifact",
            "benchmark",
            "document",
            "observation"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "trust": {
          "enum": [
            "repo-native",
            "human-authored",
            "external"
          ]
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "observed_at",
        "result",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ImplementationLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "path",
        "symbol",
        "relationship"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": [
            "implements",
            "measures",
            "proves",
            "documents"
          ]
        }
      }
    },
    "Governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_claim_fields",
        "review_policy",
        "new_capability_rule",
        "change_control"
      ],
      "properties": {
        "required_claim_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_policy": {
          "type": "string",
          "minLength": 1
        },
        "new_capability_rule": {
          "type": "string",
          "minLength": 1
        },
        "change_control": {
          "$ref": "#/$defs/ChangeControl"
        }
      }
    },
    "ChangeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_issue",
        "requires_validation",
        "requires_human_review"
      ],
      "properties": {
        "requires_issue": {
          "type": "boolean"
        },
        "requires_validation": {
          "type": "boolean"
        },
        "requires_human_review": {
          "type": "boolean"
        }
      }
    }
  }
}
