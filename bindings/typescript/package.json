{
  "name": "@decapodlabs/decapod-client",
  "version": "0.163.0",
  "description": "Library-safe TypeScript JSON-RPC and process binding for the Decapod governance kernel (#1277).",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DecapodLabs/decapod.git",
    "directory": "bindings/typescript"
  },
  "homepage": "https://github.com/DecapodLabs/decapod#readme",
  "keywords": [
    "decapod",
    "governance",
    "agents",
    "pi",
    "typescript"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
