{
  "name": "@decapodlabs/decapod-client",
  "version": "0.163.0",
  "description": "Library-safe TypeScript JSON-RPC and process binding for the Decapod governance kernel (#1277).",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "native/*.node",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build:native": "node -e \"const cp=require('child_process'),fs=require('fs'),p=require('path');cp.execFileSync('cargo',['build','--release','--manifest-path','native/Cargo.toml'],{stdio:'inherit',env:{...process.env,CARGO_PROFILE_RELEASE_STRIP:'none'}});const ext=process.platform==='darwin'?'dylib':process.platform==='win32'?'dll':'so';const pre=process.platform==='win32'?'':'lib';const src=p.join('native','target','release',pre+'decapod_napi.'+ext);const dst=p.join('native','decapod.'+process.platform+'-'+process.arch+'.node');fs.copyFileSync(src,dst);console.log('built',dst);\"",
    "bench": "node test/benchmark.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DecapodLabs/decapod.git",
    "directory": "bindings/typescript"
  },
  "homepage": "https://github.com/DecapodLabs/decapod#readme",
  "keywords": [
    "decapod",
    "governance",
    "agents",
    "pi",
    "typescript"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
